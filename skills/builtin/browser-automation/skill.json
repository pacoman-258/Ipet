{
  "version": "1.0.0",
  "tool_allowlist": [
    "playwright.",
    "playwright_mcp."
  ],
  "scripts": [
    {
      "name": "resolve_mcp_recipe",
      "description": "Resolve the visible browser MCP family and produce a standard browser recipe skeleton.",
      "path": "scripts/resolve_mcp_recipe.py",
      "input_schema": {
        "type": "object",
        "properties": {
          "visible_tool_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Visible browser tool names from the current step."
          },
          "recipe": {
            "type": "string",
            "enum": [
              "open_page",
              "open_and_type",
              "click_followup",
              "extract_or_verify"
            ]
          },
          "url": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          }
        },
        "required": [
          "visible_tool_names",
          "recipe"
        ]
      },
      "timeout_sec": 15,
      "runner": "json_stdin"
    },
    {
      "name": "compact_browser_result",
      "description": "Compress long browser text or structured browser data into a short summary and a few items.",
      "path": "scripts/compact_browser_result.py",
      "input_schema": {
        "type": "object",
        "properties": {
          "raw_text": {
            "type": "string"
          },
          "structured_data": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          },
          "max_items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        }
      },
      "timeout_sec": 15,
      "runner": "json_stdin"
    }
  ]
}
